{{! Extend the post_signin layout }}
{{#> post_signin }}
<div class="row">
    <div class="col-md-3">
        {{> sidebar activeDashboard=true }}
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2 border-right">
                        <h4 id="posts_heading">Posts</h4>
                    </div>
                    <div class="col-md-6">
                        <a id="add_new_post_btn" href="/post"><button type="button" class="btn btn-sm btn-primary">Add New</button></a>
                    </div>
                </div>
                <div class="row">&nbsp;</div>
                <div class="row">
                    {{#if posts.length}}
                        <table id="post_listing" class="table table-hover">
                            <thead class="bg-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Author</th>
                                    <th>Comments</th>
                                    <th>Date</th>
                                    <th>Views</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each posts as |post| }}
                                    <tr>  
                                        <td><a href="/post/{{ post.id }}"><small>{{ post.title }}</small></a></td>
                                        <td><small>{{ post.author }}</small></td>
                                        <td><small>{{ post.comments.length }}</small></td>
                                        <td><small>Published {{ post.publishedAt }}</small></td>
                                        <td><small>{{ post.views }}</small></td>
                                        <td>
                                            <a href="/post/{{ post.id }}/edit"><i class="fa fa-pencil-square-o"></i></a>
                                            <a href="/post/{{ post.id }}/delete" onclick="event.preventDefault(); if(confirm('Are you sure you want to delete this post?')) { document.getElementById('delete-post-{{ post.id }}').submit(); }"><i class="fa fa-trash"></i></a>
                                            <form id="delete-post-{{ post.id }}" action="/post/{{ post.id }}/delete" method="POST" style="display: none;"></form>
                                        </td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    {{else}}
                        <p>No posts available.</p>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>
{{/post_signin}}
